   photoshop:Headline="Wood trucks and industrial towers">
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Wood trucks and industrial towers</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>art</rdf:li>
     <rdf:li>collage</rdf:li>
     <rdf:li>contemporary art collage</rdf:li>
     <rdf:li>trucks</rdf:li>
     <rdf:li>logging</rdf:li>
     <rdf:li>nature</rdf:li>
     <rdf:li>deforestation</rdf:li>
     <rdf:li>industry</rdf:li>
     <rdf:li>resources</rdf:li>
     <rdf:li>ecology</rdf:li>
     <rdf:li>wood processing</rdf:li>
     <rdf:li>oil rigs</rdf:li>
     <rdf:li>finance</rdf:li>
     <rdf:li>crisis</rdf:li>
     <rdf:li>natural resources</rdf:li>
     <rdf:li>transportation</rdf:li>
     <rdf:li>supply chain</rdf:li>
     <rdf:li>business</rdf:li>
     <rdf:li>technology</rdf:li>
     <rdf:li>pollution</rdf:li>
     <rdf:li>economy</rdf:li>
     <rdf:li>sustainability</rdf:li>
     <rdf:li>conflict</rdf:li>
     <rdf:li>business ecology</rdf:li>
     <rdf:li>logistics</rdf:li>
     <rdf:li>wood</rdf:li>
     <rdf:li>conservation</rdf:li>
     <rdf:li>industrial crisis</rdf:li>
     <rdf:li>log trucks</rdf:li>
     <rdf:li>industrial progress</rdf:li>
     <rdf:li>ecosystem crisis.</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Collage in the style of modern art: timber trucks with logs and oil rigs on the background of nature. Yellow sun creates a contrasting accent.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <exif:UserComment>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </exif:UserComment>
  </rdf:Description>
 </rdf:RDF>
